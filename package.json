{
  "name": "clipforge",
  "productName": "ClipForge",
  "version": "0.1.0",
  "description": "Local replay-buffer gameplay clipper and editor for Windows",
  "main": "dist/main/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:native": "dotnet publish native/AudioCap -c Release -r win-x64 --self-contained false -o native/bin",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "dist": "npm run build:native && npm run build && node scripts/prepare-resources.mjs && electron-builder --win dir"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "local.clipforge",
    "productName": "ClipForge",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "extraResources": [
      { "from": "native/bin", "to": "native", "filter": ["AudioCap.exe", "AudioCap.dll", "AudioCap.runtimeconfig.json", "AudioCap.deps.json", "NAudio*.dll"] },
      { "from": "resources", "to": "resources" }
    ],
    "win": { "target": "dir", "icon": "resources/icon.png", "signAndEditExecutable": false }
  }
}
